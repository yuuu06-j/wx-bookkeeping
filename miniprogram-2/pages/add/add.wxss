/* pages/add/add.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background: #2c9678;
  color: white;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.type-switch {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #666;
  transition: all 0.3s;
}

.type-item.active {
  background: white;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.type-item.active.expense { color: #e64340; }
.type-item.active.income { color: #2c9678; }

.amount-input-box {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #eee;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
}

.currency {
  font-size: 60rpx;
  color: #333;
  margin-right: 20rpx;
}

.amount-input {
  flex: 1;
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  height: 100rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-item .label {
  width: 120rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.form-item input, .picker {
  flex: 1;
  font-size: 30rpx;
  color: #666;
  text-align: right;
}