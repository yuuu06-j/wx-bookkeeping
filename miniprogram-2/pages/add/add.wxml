<!--pages/add/add.wxml-->
<text>pages/add/add.wxml</text>
<view class="container">
  <view class="card">
    <!-- 收支类型切换 -->
    <view class="type-switch">
      <view class="type-item {{form.type === 'expense' ? 'active expense' : ''}}" 
            bindtap="switchType" data-type="expense">支出</view>
      <view class="type-item {{form.type === 'income' ? 'active income' : ''}}" 
            bindtap="switchType" data-type="income">收入</view>
    </view>

    <!-- 金额输入 -->
    <view class="amount-input-box">
      <text class="currency">¥</text>
      <input class="amount-input" type="digit" placeholder="0.00" 
             value="{{form.amount}}" bindinput="onAmountInput"/>
    </view>

    <!-- 分类选择 -->
    <view class="form-item">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories[form.type]}}" 
              value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{form.category || '请选择分类'}}</view>
      </picker>
    </view>

    <!-- 日期选择 -->
    <view class="form-item">
      <text class="label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker">{{form.date}}</view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注</text>
      <input placeholder="请输入备注（选填）" value="{{form.remark}}" 
             bindinput="onRemarkInput"/>
    </view>
  </view>

  <view class="btn-primary" bindtap="submit">保存</view>
</view>