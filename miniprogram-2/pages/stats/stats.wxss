/* pages/stats/stats.wxss */
.summary-card {
  background: linear-gradient(135deg, #2c9678, #3db89a);
  color: white;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-row.sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.label {
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.total {
  font-size: 56rpx;
  font-weight: bold;
}

.dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.income-dot { background: #a8e6cf; }
.expense-dot { background: #ffd3b6; }

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.rank-info {
  flex: 1;
  margin-right: 20rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.rank-bar-bg {
  display: block;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.rank-bar {
  display: block;
  height: 100%;
  background: #e64340;
  border-radius: 8rpx;
  transition: width 0.5s;
}

.rank-amount {
  font-size: 28rpx;
  color: #e64340;
  font-weight: 500;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}